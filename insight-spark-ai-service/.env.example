OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=qwen-plus
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional: closed commercial LLM, for example DeepSeek.
# Leave these empty if you do not need a separate commercial model option.
COMMERCIAL_API_KEY=your_deepseek_api_key_here
COMMERCIAL_MODEL=deepseek-chat
COMMERCIAL_BASE_URL=https://api.deepseek.com

# Optional: local private LLM via Ollama OpenAI-compatible API.
# Leave these empty if you have not deployed a local model.
LOCAL_API_KEY=ollama
LOCAL_MODEL=qwen2.5:1.5b
LOCAL_BASE_URL=http://localhost:11434/v1

DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_TTS_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
DASHSCOPE_TTS_MODEL=qwen-tts
DASHSCOPE_TTS_MALE_VOICE=Ethan
DASHSCOPE_TTS_FEMALE_VOICE=Cherry
DASHSCOPE_TTS_CACHE_TTL_SECONDS=600
DASHSCOPE_TTS_CACHE_MAX_SIZE=64